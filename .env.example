# SyncForge runtime configuration.
# Copy this file to .env next to docker-compose.ghcr.yml and fill the placeholders.

# --- App secrets ---
# Generate a long random string, e.g. `openssl rand -hex 48`.
APP_SECRET_KEY=replace-with-a-long-random-secret

# Initial admin account. Created on first start if no admin exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# --- TLS / HTTPS ---
# If you terminate TLS with a reverse proxy (Caddy, Traefik, nginx, ...)
# leave SESSION_COOKIE_SECURE=true. Set to false only for plain HTTP trials.
SESSION_COOKIE_SECURE=true

# --- Storage paths ---
# Override only if you really know what you are doing.
DATABASE_URL=sqlite:////app/backend/data/app.db
DEFAULT_TIMEZONE=Europe/Berlin

# Comma-separated list of paths the in-app file browser is allowed to show.
# Include /mnt/nas only if you actually mount a share into the container.
FILE_BROWSER_ROOTS=/app/backend/data,/app/data/config

# --- rclone ---
# Path inside the container to a working rclone.conf. Mount it via the
# syncforge-config volume or your own bind mount.
RCLONE_CONFIG=/app/data/config/rclone/rclone.conf
RCLONE_GLOBAL_FLAGS=--use-json-log --log-level INFO --stats 10s

# --- Telegram notifications (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_SUCCESS=false
TELEGRAM_NOTIFY_ON_ERROR=true